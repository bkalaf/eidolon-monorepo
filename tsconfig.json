{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["node"],
        "allowJs": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM"]
    },
    "files": ["reactFetch.ts", "packages/shared/src/index.d.ts"],
    "include": [
        "apps/**/*.{ts,tsx}",
        "packages/**/src/**/*",
        "packages/**/functions/**/*.ts",
        "packages/**/functions/**/*.tsx",
        "packages/**/vite.config.ts",
        "packages/**/nitro.config.*",
        "packages/**/drizzle.config.*",
        "services/**/*.ts",
        "services/**/*.tsx",
        "services/**/*.cts",
        "services/**/*.mts",
        "reactFetch.ts"
    ],
    "exclude": ["node_modules", ".yarn", ".git", "**/dist", "**/.output", "**/.next", "**/.cache"]
}
